# Chemical Review v2 provider configuration (names only; keep real values in a
# user-local untracked env file or the process environment).

# Optional provider endpoints/timeouts/retries/budgets
CHEMICAL_REVIEW_ENABLE_NETWORK=
CHEMICAL_REVIEW_OPENALEX_ENDPOINT=https://api.openalex.org/works
CHEMICAL_REVIEW_OPENALEX_TIMEOUT=20
CHEMICAL_REVIEW_OPENALEX_RETRIES=1
CHEMICAL_REVIEW_OPENALEX_BUDGET=20
CHEMICAL_REVIEW_SEMANTIC_SCHOLAR_ENDPOINT=https://api.semanticscholar.org/graph/v1/paper/search
CHEMICAL_REVIEW_SEMANTIC_SCHOLAR_TIMEOUT=20
CHEMICAL_REVIEW_SEMANTIC_SCHOLAR_RETRIES=1
CHEMICAL_REVIEW_SEMANTIC_SCHOLAR_BUDGET=20
CHEMICAL_REVIEW_CROSSREF_ENDPOINT=https://api.crossref.org/works
CHEMICAL_REVIEW_CROSSREF_TIMEOUT=20
CHEMICAL_REVIEW_CROSSREF_RETRIES=1
CHEMICAL_REVIEW_CROSSREF_BUDGET=20
CHEMICAL_REVIEW_PUBCHEM_ENDPOINT=https://pubchem.ncbi.nlm.nih.gov/rest/pug
CHEMICAL_REVIEW_CHEBI_ENDPOINT=https://www.ebi.ac.uk/chebi/backend/api/public/es_search/
CHEMICAL_REVIEW_UNPAYWALL_ENDPOINT=https://api.unpaywall.org/v2
CHEMICAL_REVIEW_EUROPE_PMC_ENDPOINT=https://www.ebi.ac.uk/europepmc/webservices/rest/search
CHEMICAL_REVIEW_CORE_ENDPOINT=https://api.core.ac.uk/v3/search/works

# Credential values are intentionally blank. Never commit real values.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=
UNPAYWALL_EMAIL=
CORE_API_KEY=
MINERU_COMMAND=
MINERU_ENDPOINT=
MINERU_TOKEN=
